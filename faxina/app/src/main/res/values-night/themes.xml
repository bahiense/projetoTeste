<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- As mesmas janelas do values/themes.xml, na versão escura. -->
    <style name="Theme.Faxina" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FF0E1413</item>
        <item name="android:statusBarColor">#FF0E1413</item>
        <item name="android:navigationBarColor">#FF0E1413</item>
    </style>

    <style name="Theme.Faxina.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FF0E1413</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icone</item>
        <item name="windowSplashScreenAnimationDuration">400</item>
        <item name="postSplashScreenTheme">@style/Theme.Faxina</item>
    </style>
</resources>
